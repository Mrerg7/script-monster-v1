---
import { SITE } from "../config/site";
---

<form data-inquiry class="border border-line bg-surface p-6 sm:p-8" novalidate>
  <fieldset class="grid gap-2 sm:grid-cols-3">
    <legend class="sr-only">How you want to proceed</legend>
    <label class="min-h-12 border border-line px-3 py-2">
      <input type="radio" name="intent" value="buy" />
      <span class="block font-semibold">Buy now</span>
      <span class="block text-muted">Accept the {SITE.askLabel} asking price</span>
    </label>
    <label class="min-h-12 border border-ember bg-ember-soft px-3 py-2">
      <input type="radio" name="intent" value="offer" checked />
      <span class="block font-semibold">Make offer</span>
      <span class="block text-muted">Name a serious number</span>
    </label>
    <label class="min-h-12 border border-line px-3 py-2">
      <input type="radio" name="intent" value="agent" />
      <span class="block font-semibold">Contact agent</span>
      <span class="block text-muted">Questions before a number</span>
    </label>
  </fieldset>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1 block font-medium">Name</span>
      <input class="field" name="name" autocomplete="name" required />
      <span data-error="name" class="mt-1 block text-ember" role="alert"></span>
    </label>
    <label class="block">
      <span class="mb-1 block font-medium">Email</span>
      <input class="field" name="email" type="email" autocomplete="email" inputmode="email" required />
      <span data-error="email" class="mt-1 block text-ember" role="alert"></span>
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-1 block font-medium">Intended use</span>
      <input class="field" name="use" placeholder="Studio, writing tool, marketplace…" required />
      <span data-error="use" class="mt-1 block text-ember" role="alert"></span>
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-1 block font-medium">Budget</span>
      <input class="field" name="budget" placeholder="Your number, in USD" required />
      <span data-error="budget" class="mt-1 block text-ember" role="alert"></span>
    </label>
    <label class="block sm:col-span-2">
      <span class="mb-1 flex justify-between font-medium">Note <span class="font-normal text-muted">Optional</span></span>
      <textarea class="field min-h-28" name="note" rows="4"></textarea>
    </label>
  </div>

  <button data-submit type="submit" class="btn btn-ember mt-6 w-full sm:w-auto">Send offer</button>
  <p class="mt-3 text-muted">Opens an email to {SITE.email}. Nothing is charged on this page.</p>
</form>

<div data-sent hidden class="border border-line bg-surface p-6 sm:p-8" role="status">
  <p class="uppercase tracking-[0.16em] text-ember">Inquiry ready</p>
  <h3 class="mt-2 font-display text-3xl">Your note is addressed to {SITE.email}.</h3>
  <p class="mt-3 text-muted">If your mail app did not open, use the link again. We reply within one business day.</p>
  <a class="btn btn-ember mt-6" href={`mailto:${SITE.email}`}>Open email again</a>
</div>

<noscript>
  <p class="mt-4">
    <a class="text-ember underline" href={`mailto:${SITE.email}?subject=script.monster%20Domain%20Acquisition%20Inquiry`}>
      Email {SITE.email} directly
    </a>
  </p>
</noscript>
