---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chrome from "../components/Chrome.astro";
import Inquiry from "../components/Inquiry.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title="Acquire script.monster | Premium Domain for Sale | Desert Rich"
  description={`Buy script.monster now for ${SITE.askLabel}, make an offer, or contact the agent. Escrow transfer from Phoenix, Arizona.`}
>
  <Chrome>
    <section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-12 lg:py-20">
      <div class="min-w-0 lg:col-span-5">
        <p class="uppercase tracking-[0.16em] text-ember">Acquisition</p>
        <h1 class="mt-3 font-display text-5xl leading-[0.95] tracking-tight sm:text-6xl">
          script<wbr /><span class="text-ember">.monster</span>
        </h1>
        <p class="mt-4 font-display text-4xl">{SITE.askLabel}</p>
        <p class="mt-4 text-muted">
          Buy now accepts the asking price. Make offer if you have a real number. Contact the agent if you need the
          transfer path before you bid. Replies within one business day from {SITE.email}.
        </p>
        <ul class="mt-8 space-y-3 border-t border-line pt-6 text-muted">
          <li>Escrow.com, or the buyer’s reputable escrow.</li>
          <li>Auth-code transfer or registrar push.</li>
          <li>You confirm control before funds release.</li>
          <li>Trademark clearance is the buyer’s job.</li>
        </ul>
      </div>
      <div class="min-w-0 lg:col-span-7">
        <Inquiry />
      </div>
    </section>
  </Chrome>
</BaseLayout>
