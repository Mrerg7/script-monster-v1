---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chrome from "../components/Chrome.astro";
import Inquiry from "../components/Inquiry.astro";
import { SITE } from "../config/site";

const uses = [
  ["AI & tools", "AI scriptwriting platform", "A product name that already says what the software does."],
  ["Marketplace", "Screenplay and manuscript market", "A destination name for buying, selling, and optioning stories."],
  ["Community", "Writer community or accelerator", "A name people can repeat after hearing it once."],
  ["Studio", "Production company", "Short enough for a slate, a credit, and the spine of a deck."],
  ["Author brand", "Showrunner or author platform", "A personal house for the work, the list, and the store."],
  ["SaaS", "Creative tool suite", "Coverage, outlining, and production tools on a category name."],
];

const reasons = [
  ["01", "Exact-match keyword", "“Script” is the word writers, producers, and tools already search."],
  ["02", "It already sounds like a company", "ScriptMonster is two beats. Usable on a logo, an app, and a credit."],
  ["03", "The TLD does the attitude", ".monster is the edge. Creative nerve, not a crowded .com fight."],
  ["04", "Timed to the tools", "AI-assisted writing and independent series are where the next studios get named."],
];
---

<BaseLayout>
  <Chrome>
    <section class="border-b border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-12 lg:py-20">
        <div class="min-w-0 lg:col-span-7">
          <p class="uppercase tracking-[0.18em] text-ember">Premium domain · For sale</p>
          <h1 class="mt-4 font-display text-5xl leading-[0.9] tracking-tight sm:text-7xl lg:text-8xl">
            script<wbr /><span class="text-ember">.monster</span>
          </h1>
          <p class="mt-6 font-display text-3xl leading-tight sm:text-4xl">Unleash the monster.</p>
          <p class="mt-4 max-w-xl text-muted">
            The script is in you. This is the exact-match name for the screenplay, the series, or the tool that
            finally gets out of the drawer. Six letters. One owner. Asking {SITE.askLabel}.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-ember" href="/acquire/?intent=buy">Buy now</a>
            <a class="btn btn-line" href="/acquire/?intent=offer">Make offer</a>
            <a class="btn" href="/acquire/?intent=agent">Contact agent</a>
          </div>
        </div>
        <aside class="min-w-0 border border-line bg-surface p-6 lg:col-span-5 lg:p-8">
          <p class="uppercase tracking-[0.16em] text-muted">Asking price</p>
          <p class="mt-2 font-display text-5xl tracking-tight sm:text-6xl">{SITE.askLabel}</p>
          <p class="mt-2 text-muted">USD. Or a serious offer. Escrow.com, or your escrow.</p>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-line pt-6">
            <div><dt class="text-muted">Keyword</dt><dd class="font-semibold">script</dd></div>
            <div><dt class="text-muted">Extension</dt><dd class="font-semibold">.monster</dd></div>
            <div><dt class="text-muted">Length</dt><dd class="font-semibold">6 letters</dd></div>
            <div><dt class="text-muted">Seller</dt><dd class="font-semibold">Phoenix, AZ</dd></div>
          </dl>
          <p class="mt-6 text-muted">Funds stay in escrow until the name is in your registrar account.</p>
        </aside>
      </div>
    </section>

    <section id="vision" class="border-b border-line">
      <div class="mx-auto max-w-3xl px-5 py-16 lg:py-24">
        <h2 class="font-display text-4xl sm:text-5xl">The vision</h2>
        <div class="mt-6 space-y-5 text-lg">
          <p>A laptop and a connection are enough to write the thing. The tools got cheap. The nerve did not.</p>
          <p>
            <strong>script.monster</strong> is for the person done waiting on permission. It is a name with a spine:
            a battle cry you can put on a studio, a product, or the top of the page.
          </p>
          <p class="font-display text-3xl leading-tight">
            That monster inside you is not something to fear. It is something to ride.
          </p>
        </div>
      </div>
    </section>

    <section id="fit" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:py-24">
        <h2 class="font-display text-4xl sm:text-5xl">Where the name earns its keep</h2>
        <p class="mt-4 max-w-2xl text-muted">
          Filter the fit. This is one domain, not a catalog — the categories are the businesses it can front.
        </p>
        <label class="mt-8 block">
          <span class="sr-only">Search use cases</span>
          <input data-search class="field" placeholder="Search: studio, marketplace, AI…" />
        </label>
        <div class="mt-4 flex flex-wrap gap-2" role="toolbar" aria-label="Filter by category">
          <button type="button" data-filter="All" aria-pressed="true" class="h-12 bg-fg px-4 font-medium text-bg">All</button>
          {["AI & tools", "Marketplace", "Community", "Studio", "Author brand", "SaaS"].map((cat) => (
            <button type="button" data-filter={cat} aria-pressed="false" class="h-12 border border-line px-4 font-medium">
              {cat}
            </button>
          ))}
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            uses.map(([cat, title, text]) => (
              <li
                data-cat={cat}
                data-search={`${cat} ${title} ${text}`.toLowerCase()}
                class="border border-line bg-surface p-5"
              >
                <p class="text-ember">{cat}</p>
                <h3 class="mt-1 font-display text-2xl">{title}</h3>
                <p class="mt-2 text-muted">{text}</p>
              </li>
            ))
          }
          <li data-empty hidden class="border border-dashed border-line p-6 text-muted sm:col-span-2">
            Nothing matches that filter. Try another word, or clear the search.
          </li>
        </ul>
      </div>
    </section>

    <section id="why" class="border-b border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-12 lg:py-24">
        <div class="min-w-0 lg:col-span-4">
          <h2 class="font-display text-4xl sm:text-5xl">Why this string holds a premium</h2>
          <p class="mt-4 text-muted">Not a commodity listing. A category word with an attitude attached.</p>
        </div>
        <ol class="min-w-0 lg:col-span-8">
          {
            reasons.map(([n, title, text]) => (
              <li class="grid grid-cols-[auto_1fr] gap-4 border-t border-line py-6">
                <span class="font-display text-2xl text-ember">{n}</span>
                <div>
                  <h3 class="font-display text-2xl">{title}</h3>
                  <p class="mt-2 text-muted">{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="invest" class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:py-24">
        <h2 class="font-display text-4xl sm:text-5xl">The investment, plainly</h2>
        <div class="mt-8 grid gap-px bg-line sm:grid-cols-2">
          <article class="bg-bg p-6"><h3 class="font-display text-2xl">Scarcity</h3><p class="mt-2 text-muted">One spelling. One registry. You either own the category word or you rent around it.</p></article>
          <article class="bg-bg p-6"><h3 class="font-display text-2xl">Brand velocity</h3><p class="mt-2 text-muted">It works on day one. No coined-name campaign to teach people how to say it.</p></article>
          <article class="bg-bg p-6"><h3 class="font-display text-2xl">End user</h3><p class="mt-2 text-muted">AI writing tools, studios, marketplaces, and creators who buy names on purpose.</p></article>
          <article class="bg-bg p-6"><h3 class="font-display text-2xl">Ceiling</h3><p class="mt-2 text-muted">As story tools multiply, the exact word gets harder to find, not easier.</p></article>
        </div>
        <p class="mt-8"><a class="font-semibold text-ember underline decoration-line underline-offset-4" href="/brief/">Read the one-page valuation brief</a></p>
      </div>
    </section>

    <section class="border-b border-line">
      <div class="mx-auto max-w-6xl px-5 py-16 lg:py-24">
        <h2 class="font-display text-4xl sm:text-5xl">Who it is for</h2>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          <li class="py-4 text-lg">Founders building the next writing or story tool</li>
          <li class="py-4 text-lg">Studios that want a name with a pulse</li>
          <li class="py-4 text-lg">Authors and showrunners opening their own platform</li>
          <li class="py-4 text-lg">Investors who buy the name before the product</li>
        </ul>
      </div>
    </section>

    <section class="border-b border-line">
      <div class="mx-auto grid max-w-6xl gap-6 px-5 py-16 sm:grid-cols-3 lg:py-24">
        <article class="border border-line p-6"><p class="font-display text-3xl text-ember">1</p><h2 class="mt-3 font-display text-2xl">Inquire</h2><p class="mt-2 text-muted">Buy now, make an offer, or ask a question. Replies within one business day.</p></article>
        <article class="border border-line p-6"><p class="font-display text-3xl text-ember">2</p><h2 class="mt-3 font-display text-2xl">Agree in escrow</h2><p class="mt-2 text-muted">A written deal. Funds sit with Escrow.com until the name moves.</p></article>
        <article class="border border-line p-6"><p class="font-display text-3xl text-ember">3</p><h2 class="mt-3 font-display text-2xl">Transfer</h2><p class="mt-2 text-muted">Auth code or registrar push. You confirm the name before funds release.</p></article>
      </div>
    </section>

    <section id="acquire" class="px-5 py-16 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-5">
          <p class="uppercase tracking-[0.16em] text-ember">Acquire</p>
          <h2 class="mt-3 font-display text-4xl sm:text-5xl">Own the narrative.</h2>
          <p class="mt-4 text-muted">Serious buyers only. {SITE.askLabel} to buy now, or send a number you can stand behind. {SITE.email}.</p>
        </div>
        <div class="min-w-0 lg:col-span-7">
          <Inquiry />
        </div>
      </div>
    </section>
  </Chrome>
</BaseLayout>
